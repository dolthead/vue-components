{
  "name": "ionic-vue-components",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "An Ionic project",
  "scripts": {
    "serve": "vite dev --host",
    "build": "vue-tsc --noEmit && vite build",
    "e2e": "cypress run",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "serve:pwa": "vite build --mode pwa && vite preview --host --mode pwa",
    "deploy": "vue-tsc --noEmit && vite build && firebase deploy",
    "assets": "npx @capacitor/assets generate --iconBackgroundColor '#eeeeee' --iconBackgroundColorDark '#222222' --splashBackgroundColor '#eeeeee' --splashBackgroundColorDark '#111111'"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.1",
    "@capacitor/core": "^7.4.4",
    "@capacitor/haptics": "^7.0.3",
    "@capacitor/keyboard": "^7.0.4",
    "@capacitor/status-bar": "^7.0.4",
    "@ionic/core": "^8.7.16",
    "@ionic/vue": "^8.7.16",
    "@ionic/vue-router": "^8.7.16",
    "core-js": "^3.47.0",
    "ionicons": "^7.4.0",
    "swiper": "^9.4.1",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "^7.4.4",
    "@cypress/request": "^3.0.9",
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-c8": "^0.26.3",
    "@vue/eslint-config-typescript": "^9.1.0",
    "@vue/test-utils": "^2.4.6",
    "cypress": "^8.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^8.7.1",
    "jsdom": "^20.0.3",
    "jshint": "^2.13.6",
    "sass": "^1.97.1",
    "semver": "^7.7.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^0.26.3",
    "vue-tsc": "^2.2.12",
    "workbox-build": "^7.4.0",
    "workbox-window": "^7.4.0"
  }
}